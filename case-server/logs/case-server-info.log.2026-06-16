码登录', 'item_type': 'rule', 'content': '同一手机号每日验证码发送上限为10次，达到上限后提示', 'priority': 'P1', 'source_case_ids': ['TC019', 'TC020'], 'status': 'active'}, {'id': 'ki_010', 'module': '手机号验证码登录', 'item_type': 'rule', 'content': '验证码有效期为5分钟，过期后需重新获取', 'priority': 'P1', 'source_case_ids': ['TC013', 'TC014', 'TC015'], 'status': 'active'}, {'id': 'ki_011', 'module': '手机号验证码登录', 'item_type': 'rule', 'content': '黑名单用户和冻结用户均不可登录，提示账号不可登录', 'priority': 'P0', 'source_case_ids': ['TC008', 'TC009'], 'status': 'active'}, {'id': 'ki_012', 'module': '手机号验证码登录', 'item_type': 'rule', 'content': '不同手机号独立计算每日发送上限，互不影响', 'priority': 'P1', 'source_case_ids': ['TC033'], 'status': 'active'}, {'id': 'ki_013', 'module': '手机号验证码登录', 'item_type': 'rule', 'content': '连续5次输入错误验证码触发风控限制，提示操作过于频繁', 'priority': 'P2', 'source_case_ids': ['TC039'], 'status': 'active'}, {'id': 'ki_014', 'module': '手机号验证码登录', 'item_type': 'rule', 'content': '登录接口具备防重放攻击机制，同一请求包不可重复使用', 'priority': 'P2', 'source_case_ids': ['TC044'], 'status': 'active'}, {'id': 'ki_015', 'module': '手机号验证码登录', 'item_type': 'rule', 'content': '验证码仅通过短信发送，响应体和日志中不得包含验证码明文', 'priority': 'P2', 'source_case_ids': ['TC041'], 'status': 'active'}, {'id': 'ki_016', 'module': '手机号验证码登录', 'item_type': 'boundary', 'content': '验证码有效期边界：4分59秒内有效，5分钟整过期，5分01秒过期', 'priority': 'P1', 'source_case_ids': ['TC013', 'TC014', 'TC015'], 'status': 'active'}, {'id': 'ki_017', 'module': '手机号验证码登录', 'item_type': 'boundary', 'content': '验证码发送间隔边界：59秒失败，60秒整成功，61秒成功', 'priority': 'P1', 'source_case_ids': ['TC016', 'TC017', 'TC018'], 'status': 'active'}, {'id': 'ki_018', 'module': '手机号验证码登录', 'item_type': 'boundary', 'content': '每日发送次数边界：第10次成功，第11次达上限', 'priority': 'P1', 'source_case_ids': ['TC019', 'TC020'], 'status': 'active'}, {'id': 'ki_019', 'module': '手机号验证码登录', 'item_type': 'boundary', 'content': '手机号位数边界：10位和12位均提示格式错误', 'priority': 'P1', 'source_case_ids': ['TC021', 'TC022'], 'status': 'active'}, {'id': 'ki_020', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '网络异常时获取验证码或登录均提示网络异常请重试', 'priority': 'P1', 'source_case_ids': ['TC007', 'TC026', 'TC027'], 'status': 'active'}, {'id': 'ki_021', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '输入错误验证码时提示验证码错误，可等待60秒后重新获取正确验证码登录', 'priority': 'P1', 'source_case_ids': ['TC012', 'TC101'], 'status': 'active'}, {'id': 'ki_022', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '验证码发送失败时服务端记录日志，用户可联系客服处理', 'priority': 'P2', 'source_case_ids': ['TC103'], 'status': 'active'}, {'id': 'ki_023', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '验证码已发送但未收到短信时可等待60秒后重新获取', 'priority': 'P1', 'source_case_ids': ['TC102'], 'status': 'active'}, {'id': 'ki_024', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '短时间内大量调用验证码发送接口触发防刷限流机制', 'priority': 'P2', 'source_case_ids': ['TC040'], 'status': 'active'}, {'id': 'ki_025', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '接口响应时间需在预期范围内（如小于2秒）', 'priority': 'P2', 'source_case_ids': ['TC042'], 'status': 'active'}, {'id': 'ki_026', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '手机号为空时提示请输入手机号，验证码为空时提示请输入验证码', 'priority': 'P2', 'source_case_ids': ['TC034', 'TC035'], 'status': 'active'}, {'id': 'ki_027', 'module': '手机号验证码登录', 'item_type': 'exception', 'content': '验证码位数不足6位或含字母/特殊字符时提示格式错误', 'priority': 'P2', 'source_case_ids': ['TC036', 'TC037', 'TC038'], 'status': 'active'}, {'id': 'ki_028', 'module': '新用户注册', 'item_type': 'feature', 'content': '新用户输入手机号和验证码后跳转至信息补全页面，填写账号名称和头像后完成注册并自动登录跳转首页', 'priority': 'P0', 'source_case_ids': ['TC045', 'TC050', 'TC098', 'TC099'], 'status': 'active'}, {'id': 'ki_029', 'module': '新用户注册', 'item_type': 'feature', 'content': '信息补全页面点击取消或返回则返回登录页，不生成注册记录', 'priority': 'P1', 'source_case_ids': ['TC100'], 'status': 'active'}, {'id': 'ki_030', 'module': '新用户注册', 'item_type': 'rule', 'content': '账号名称和头像均为必填项，任一为空时提示不能为空', 'priority': 'P0', 'source_case_ids': ['TC046', 'TC047', 'TC048'], 'status': 'active'}, {'id': 'ki_031', 'module': '新用户注册', 'item_type': 'rule', 'content': '已注册手机号不可重复注册，提示手机号已注册', 'priority': 'P0', 'source_case_ids': ['TC049'], 'status': 'active'}, {'id': 'ki_032', 'module': '新用户注册', 'item_type': 'rule', 'content': '账号名称支持中英文数字组合，不支持特殊字符，含敏感词时提示不合规', 'priority': 'P1', 'source_case_ids': ['TC051', 'TC052', 'TC053'], 'status': 'active'}, {'id': 'ki_033', 'module': '新用户注册', 'item_type': 'rule', 'content': '账号名称长度限制为1-20个字符', 'priority': 'P1', 'source_case_ids': ['TC054', 'TC055'], 'status': 'active'}, {'id': 'ki_034', 'module': '新用户注册', 'item_type': 'rule', 'content': '头像仅支持图片格式，大小限制为5MB以内', 'priority': 'P1', 'source_case_ids': ['TC056', 'TC057'], 'status': 'active'}, {'id': 'ki_035', 'module': '新用户注册', 'item_type': 'exception', 'content': '注册时验证码错误或过期分别提示验证码错误和验证码已过期', 'priority': 'P1', 'source_case_ids': ['TC060', 'TC061'], 'status': 'active'}, {'id': 'ki_036', 'module': '新用户注册', 'item_type': 'exception', 'content': '头像上传中断或服务器错误时提示上传失败', 'priority': 'P1', 'source_case_ids': ['TC058', 'TC059'], 'status': 'active'}, {'id': 'ki_037', 'module': '新用户注册', 'item_type': 'exception', 'content': '网络异常时无法获取验证码，提示网络异常请稍后重试', 'priority': 'P1', 'source_case_ids': ['TC062'], 'status': 'active'}, {'id': 'ki_038', 'module': '用户注销', 'item_type': 'feature', 'content': '用户提交注销申请后进入7个工作日观察期，观察期内未登录则自动完成注销', 'priority': 'P0', 'source_case_ids': ['TC063', 'TC064', 'TC065'], 'status': 'active'}, {'id': 'ki_039', 'module': '用户注销', 'item_type': 'feature', 'content': '观察期内任意一次登录均停止注销流程并恢复账号正常状态，观察期从最近登录日重新计算', 'priority': 'P0', 'source_case_ids': ['TC066', 'TC069', 'TC070', 'TC072', 'TC075', 'TC077'], 'status': 'active'}, {'id': 'ki_040', 'module': '用户注销', 'item_type': 'feature', 'content': '注销完成后原账号无法登录，提示账号已注销', 'priority': 'P0', 'source_case_ids': ['TC067', 'TC068', 'TC071'], 'status': 'active'}, {'id': 'ki_041', 'module': '用户注销', 'item_type': 'rule', 'content': '观察期7个工作日正确排除周末和法定节假日（如春节、国庆等）', 'priority': 'P1', 'source_case_ids': ['TC073', 'TC107', 'TC108'], 'status': 'active'}, {'id': 'ki_042', 'module': '用户注销', 'item_type': 'rule', 'content': '注销完成后用户个人数据脱敏或清除（手机号、头像、昵称等），不可恢复', 'priority': 'P2', 'source_case_ids': ['TC078'], 'status': 'active'}, {'id': 'ki_043', 'module': '用户注销', 'item_type': 'rule', 'content': '注销完成后无法通过找回密码恢复账号', 'priority': 'P1', 'source_case_ids': ['TC076'], 'status': 'active'}, {'id': 'ki_044', 'module': '用户注销', 'item_type': 'rule', 'content': '观察期内部分核心功能（发布内容、修改个人信息等）受限', 'priority': 'P1', 'source_case_ids': ['TC104'], 'status': 'active'}, {'id': 'ki_045', 'module': '用户注销', 'item_type': 'exception', 'content': '网络异常时提交注销申请不生成注销记录，提示网络异常请稍后重试', 'priority': 'P1', 'source_case_ids': ['TC074'], 'status': 'active'}, {'id': 'ki_046', 'module': '首页访问控制', 'item_type': 'feature', 'content': '未登录用户可正常浏览首页全部内容，点击任意可交互元素（按钮、链接、图片、文章标题等）均跳转至登录页', 'priority': 'P0', 'source_case_ids': ['TC079', 'TC080', 'TC081', 'TC082', 'TC083', 'TC084', 'TC089', 'TC091'], 'status': 'active'}, {'id': 'ki_047', 'module': '首页访问控制', 'item_type': 'feature', 'content': '已登录用户点击首页可交互元素正常跳转至目标页面', 'priority': 'P0', 'source_case_ids': ['TC085', 'TC086', 'TC087', 'TC088'], 'status': 'active'}, {'id': 'ki_048', 'module': '首页访问控制', 'item_type': 'feature', 'content': '未登录用户点击内容跳转登录页后登录成功，自动返回之前点击的内容详情页', 'priority': 'P1', 'source_case_ids': ['TC090', 'TC095'], 'status': 'active'}, {'id': 'ki_049', 'module': '首页访问控制', 'item_type': 'feature', 'content': '已登录用户退出登录后首页内容正常展示，点击元素跳转登录页', 'priority': 'P1', 'source_case_ids': ['TC105'], 'status': 'active'}, {'id': 'ki_050', 'module': '首页访问控制', 'item_type': 'rule', 'content': '未登录用户通过直接URL访问内容详情页时校验登录状态，未登录则跳转登录页', 'priority': 'P1', 'source_case_ids': ['TC096'], 'status': 'active'}, {'id': 'ki_051', 'module': '首页访问控制', 'item_type': 'rule', 'content': '登录态过期后点击首页元素跳转登录页并提示登录已过期', 'priority': 'P1', 'source_case_ids': ['TC092'], 'status': 'active'}, {'id': 'ki_052', 'module': '首页访问控制', 'item_type': 'rule', 'content': '跳转登录页时URL不携带用户敏感信息（手机号、密码等）', 'priority': 'P2', 'source_case_ids': ['TC097'], 'status': 'active'}, {'id': 'ki_053', 'module': '首页访问控制', 'item_type': 'exception', 'content': '网络异常时未登录用户点击元素走离线处理逻辑不跳转登录页，已登录用户给出加载失败提示', 'priority': 'P1', 'source_case_ids': ['TC093', 'TC094'], 'status': 'active'}, {'id': 'ki_054', 'module': '首页访问控制', 'item_type': 'exception', 'content': '已注销账号访问首页行为与未登录用户一致，点击内容跳转登录页', 'priority': 'P1', 'source_case_ids': ['TC109'], 'status': 'active'}, {'id': 'ki_055', 'module': '首页访问控制', 'item_type': 'exception', 'content': '未登录与已登录状态下首页加载时间均在可接受范围内', 'priority': 'P2', 'source_case_ids': ['TC106'], 'status': 'active'}], 'changes': []}", "status": "active", "created_at": "2026-06-15 21:35:13", "updated_at": "2026-06-15 21:35:13", "items": [{"id": "kb_1705657b_7cb241fa61e8", "module": "手机号验证码登录", "item_type": "feature", "content": "已注册用户输入正确手机号和验证码后登录成功，跳转至首页并返回有效token", "priority": "P0", "source_case_ids": ["TC001", "TC002", "TC003", "TC004"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.565553+00:00"}, {"id": "kb_1705657b_60089e1b3347", "module": "手机号验证码登录", "item_type": "feature", "content": "新用户首次登录时系统自动完成注册并登录成功", "priority": "P0", "source_case_ids": ["TC005"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570773+00:00"}, {"id": "kb_1705657b_2a4f92c8f383", "module": "手机号验证码登录", "item_type": "feature", "content": "获取验证码后手机收到含6位纯数字验证码的短信", "priority": "P0", "source_case_ids": ["TC006", "TC017", "TC018"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570821+00:00"}, {"id": "kb_1705657b_fb8ec954081d", "module": "手机号验证码登录", "item_type": "feature", "content": "同一已注册用户支持App、小程序、H5多端登录，跨端会话可保持", "priority": "P1", "source_case_ids": ["TC010", "TC011", "TC029", "TC030", "TC031"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570842+00:00"}, {"id": "kb_1705657b_e1b38cb17e92", "module": "手机号验证码登录", "item_type": "feature", "content": "登录成功后将token存储至客户端本地，退出登录后token被清除", "priority": "P2", "source_case_ids": ["TC043"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570859+00:00"}, {"id": "kb_1705657b_9513c439b8ec", "module": "手机号验证码登录", "item_type": "feature", "content": "黑名单用户更换正常手机号后可正常登录", "priority": "P1", "source_case_ids": ["TC032"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570877+00:00"}, {"id": "kb_1705657b_1ba6116824f4", "module": "手机号验证码登录", "item_type": "rule", "content": "手机号格式校验：须为11位纯数字（支持自动去除空格和+86前缀），不支持字母、特殊字符及非大陆手机号", "priority": "P1", "source_case_ids": ["TC002", "TC003", "TC021", "TC022", "TC023", "TC024", "TC025"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570894+00:00"}, {"id": "kb_1705657b_da944a1248e0", "module": "手机号验证码登录", "item_type": "rule", "content": "验证码发送间隔限制为60秒，60秒内重复点击提示间隔不足", "priority": "P1", "source_case_ids": ["TC016", "TC017", "TC018", "TC028"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570915+00:00"}, {"id": "kb_1705657b_0f6bb690160a", "module": "手机号验证码登录", "item_type": "rule", "content": "同一手机号每日验证码发送上限为10次，达到上限后提示", "priority": "P1", "source_case_ids": ["TC019", "TC020"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570934+00:00"}, {"id": "kb_1705657b_fa2afc11ff2d", "module": "手机号验证码登录", "item_type": "rule", "content": "验证码有效期为5分钟，过期后需重新获取", "priority": "P1", "source_case_ids": ["TC013", "TC014", "TC015"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.570951+00:00"}, {"id": "kb_1705657b_c30cc0fdb5c4", "module": "手机号验证码登录", "item_type": "rule", "content": "黑名单用户和冻结用户均不可登录，提示账号不可登录", "priority": "P0", "source_case_ids": ["TC008", "TC009"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571379+00:00"}, {"id": "kb_1705657b_491ac15dedc9", "module": "手机号验证码登录", "item_type": "rule", "content": "不同手机号独立计算每日发送上限，互不影响", "priority": "P1", "source_case_ids": ["TC033"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571416+00:00"}, {"id": "kb_1705657b_7c295c73a36d", "module": "手机号验证码登录", "item_type": "rule", "content": "连续5次输入错误验证码触发风控限制，提示操作过于频繁", "priority": "P2", "source_case_ids": ["TC039"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571436+00:00"}, {"id": "kb_1705657b_cfd14a33c781", "module": "手机号验证码登录", "item_type": "rule", "content": "登录接口具备防重放攻击机制，同一请求包不可重复使用", "priority": "P2", "source_case_ids": ["TC044"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571453+00:00"}, {"id": "kb_1705657b_684bb22e3dbe", "module": "手机号验证码登录", "item_type": "rule", "content": "验证码仅通过短信发送，响应体和日志中不得包含验证码明文", "priority": "P2", "source_case_ids": ["TC041"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571470+00:00"}, {"id": "kb_1705657b_6e57e4413b8c", "module": "手机号验证码登录", "item_type": "boundary", "content": "验证码有效期边界：4分59秒内有效，5分钟整过期，5分01秒过期", "priority": "P1", "source_case_ids": ["TC013", "TC014", "TC015"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571486+00:00"}, {"id": "kb_1705657b_df731de890b5", "module": "手机号验证码登录", "item_type": "boundary", "content": "验证码发送间隔边界：59秒失败，60秒整成功，61秒成功", "priority": "P1", "source_case_ids": ["TC016", "TC017", "TC018"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.571501+00:00"}, {"id": "kb_1705657b_c5c26185ef3f", "module": "手机号验证码登录", "item_type": "boundary", "content": "每日发送次数边界：第10次成功，第11次达上限", "priority": "P1", "source_case_ids": ["TC019", "TC020"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.572894+00:00"}, {"id": "kb_1705657b_7aa589c8d3f7", "module": "手机号验证码登录", "item_type": "boundary", "content": "手机号位数边界：10位和12位均提示格式错误", "priority": "P1", "source_case_ids": ["TC021", "TC022"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573016+00:00"}, {"id": "kb_1705657b_6539d50202ce", "module": "手机号验证码登录", "item_type": "exception", "content": "网络异常时获取验证码或登录均提示网络异常请重试", "priority": "P1", "source_case_ids": ["TC007", "TC026", "TC027"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573035+00:00"}, {"id": "kb_1705657b_556f41d608d0", "module": "手机号验证码登录", "item_type": "exception", "content": "输入错误验证码时提示验证码错误，可等待60秒后重新获取正确验证码登录", "priority": "P1", "source_case_ids": ["TC012", "TC101"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573053+00:00"}, {"id": "kb_1705657b_62911e3f2f53", "module": "手机号验证码登录", "item_type": "exception", "content": "验证码发送失败时服务端记录日志，用户可联系客服处理", "priority": "P2", "source_case_ids": ["TC103"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573071+00:00"}, {"id": "kb_1705657b_a48727b312b6", "module": "手机号验证码登录", "item_type": "exception", "content": "验证码已发送但未收到短信时可等待60秒后重新获取", "priority": "P1", "source_case_ids": ["TC102"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573087+00:00"}, {"id": "kb_1705657b_1a3a23d69337", "module": "手机号验证码登录", "item_type": "exception", "content": "短时间内大量调用验证码发送接口触发防刷限流机制", "priority": "P2", "source_case_ids": ["TC040"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573104+00:00"}, {"id": "kb_1705657b_b61fe8aa45e4", "module": "手机号验证码登录", "item_type": "exception", "content": "接口响应时间需在预期范围内（如小于2秒）", "priority": "P2", "source_case_ids": ["TC042"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573121+00:00"}, {"id": "kb_1705657b_30e09276a6f1", "module": "手机号验证码登录", "item_type": "exception", "content": "手机号为空时提示请输入手机号，验证码为空时提示请输入验证码", "priority": "P2", "source_case_ids": ["TC034", "TC035"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573137+00:00"}, {"id": "kb_1705657b_ca3b9b93dd9b", "module": "手机号验证码登录", "item_type": "exception", "content": "验证码位数不足6位或含字母/特殊字符时提示格式错误", "priority": "P2", "source_case_ids": ["TC036", "TC037", "TC038"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573154+00:00"}, {"id": "kb_1705657b_c5c606a9987e", "module": "新用户注册", "item_type": "feature", "content": "新用户输入手机号和验证码后跳转至信息补全页面，填写账号名称和头像后完成注册并自动登录跳转首页", "priority": "P0", "source_case_ids": ["TC045", "TC050", "TC098", "TC099"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573170+00:00"}, {"id": "kb_1705657b_6e4827a68e3a", "module": "新用户注册", "item_type": "feature", "content": "信息补全页面点击取消或返回则返回登录页，不生成注册记录", "priority": "P1", "source_case_ids": ["TC100"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573187+00:00"}, {"id": "kb_1705657b_11620005f4da", "module": "新用户注册", "item_type": "rule", "content": "账号名称和头像均为必填项，任一为空时提示不能为空", "priority": "P0", "source_case_ids": ["TC046", "TC047", "TC048"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573204+00:00"}, {"id": "kb_1705657b_ca1d87be00f3", "module": "新用户注册", "item_type": "rule", "content": "已注册手机号不可重复注册，提示手机号已注册", "priority": "P0", "source_case_ids": ["TC049"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573220+00:00"}, {"id": "kb_1705657b_d162e173a6fe", "module": "新用户注册", "item_type": "rule", "content": "账号名称支持中英文数字组合，不支持特殊字符，含敏感词时提示不合规", "priority": "P1", "source_case_ids": ["TC051", "TC052", "TC053"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573237+00:00"}, {"id": "kb_1705657b_4fde3dac6949", "module": "新用户注册", "item_type": "rule", "content": "账号名称长度限制为1-20个字符", "priority": "P1", "source_case_ids": ["TC054", "TC055"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573253+00:00"}, {"id": "kb_1705657b_033184503091", "module": "新用户注册", "item_type": "rule", "content": "头像仅支持图片格式，大小限制为5MB以内", "priority": "P1", "source_case_ids": ["TC056", "TC057"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573330+00:00"}, {"id": "kb_1705657b_313896ded94c", "module": "新用户注册", "item_type": "exception", "content": "注册时验证码错误或过期分别提示验证码错误和验证码已过期", "priority": "P1", "source_case_ids": ["TC060", "TC061"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573350+00:00"}, {"id": "kb_1705657b_3c5f90da2ea3", "module": "新用户注册", "item_type": "exception", "content": "头像上传中断或服务器错误时提示上传失败", "priority": "P1", "source_case_ids": ["TC058", "TC059"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573366+00:00"}, {"id": "kb_1705657b_07af19df2b19", "module": "新用户注册", "item_type": "exception", "content": "网络异常时无法获取验证码，提示网络异常请稍后重试", "priority": "P1", "source_case_ids": ["TC062"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573384+00:00"}, {"id": "kb_1705657b_813b0ad55542", "module": "用户注销", "item_type": "feature", "content": "用户提交注销申请后进入7个工作日观察期，观察期内未登录则自动完成注销", "priority": "P0", "source_case_ids": ["TC063", "TC064", "TC065"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573400+00:00"}, {"id": "kb_1705657b_815fed020279", "module": "用户注销", "item_type": "feature", "content": "观察期内任意一次登录均停止注销流程并恢复账号正常状态，观察期从最近登录日重新计算", "priority": "P0", "source_case_ids": ["TC066", "TC069", "TC070", "TC072", "TC075", "TC077"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573416+00:00"}, {"id": "kb_1705657b_675ad8860384", "module": "用户注销", "item_type": "feature", "content": "注销完成后原账号无法登录，提示账号已注销", "priority": "P0", "source_case_ids": ["TC067", "TC068", "TC071"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573432+00:00"}, {"id": "kb_1705657b_82b40130cc5e", "module": "用户注销", "item_type": "rule", "content": "观察期7个工作日正确排除周末和法定节假日（如春节、国庆等）", "priority": "P1", "source_case_ids": ["TC073", "TC107", "TC108"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573447+00:00"}, {"id": "kb_1705657b_63e228b5ffdd", "module": "用户注销", "item_type": "rule", "content": "注销完成后用户个人数据脱敏或清除（手机号、头像、昵称等），不可恢复", "priority": "P2", "source_case_ids": ["TC078"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573463+00:00"}, {"id": "kb_1705657b_1ee2c0acef63", "module": "用户注销", "item_type": "rule", "content": "注销完成后无法通过找回密码恢复账号", "priority": "P1", "source_case_ids": ["TC076"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573480+00:00"}, {"id": "kb_1705657b_522f5351a151", "module": "用户注销", "item_type": "rule", "content": "观察期内部分核心功能（发布内容、修改个人信息等）受限", "priority": "P1", "source_case_ids": ["TC104"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573497+00:00"}, {"id": "kb_1705657b_940fd13079e2", "module": "用户注销", "item_type": "exception", "content": "网络异常时提交注销申请不生成注销记录，提示网络异常请稍后重试", "priority": "P1", "source_case_ids": ["TC074"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573513+00:00"}, {"id": "kb_1705657b_0f290106a078", "module": "首页访问控制", "item_type": "feature", "content": "未登录用户可正常浏览首页全部内容，点击任意可交互元素（按钮、链接、图片、文章标题等）均跳转至登录页", "priority": "P0", "source_case_ids": ["TC079", "TC080", "TC081", "TC082", "TC083", "TC084", "TC089", "TC091"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573529+00:00"}, {"id": "kb_1705657b_1e8ec405ce19", "module": "首页访问控制", "item_type": "feature", "content": "已登录用户点击首页可交互元素正常跳转至目标页面", "priority": "P0", "source_case_ids": ["TC085", "TC086", "TC087", "TC088"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573543+00:00"}, {"id": "kb_1705657b_bf224a950f34", "module": "首页访问控制", "item_type": "feature", "content": "未登录用户点击内容跳转登录页后登录成功，自动返回之前点击的内容详情页", "priority": "P1", "source_case_ids": ["TC090", "TC095"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573559+00:00"}, {"id": "kb_1705657b_87a72781cb4a", "module": "首页访问控制", "item_type": "feature", "content": "已登录用户退出登录后首页内容正常展示，点击元素跳转登录页", "priority": "P1", "source_case_ids": ["TC105"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573575+00:00"}, {"id": "kb_1705657b_463d39a45fed", "module": "首页访问控制", "item_type": "rule", "content": "未登录用户通过直接URL访问内容详情页时校验登录状态，未登录则跳转登录页", "priority": "P1", "source_case_ids": ["TC096"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573594+00:00"}, {"id": "kb_1705657b_db141ea18066", "module": "首页访问控制", "item_type": "rule", "content": "登录态过期后点击首页元素跳转登录页并提示登录已过期", "priority": "P1", "source_case_ids": ["TC092"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573612+00:00"}, {"id": "kb_1705657b_d1fc39e963d3", "module": "首页访问控制", "item_type": "rule", "content": "跳转登录页时URL不携带用户敏感信息（手机号、密码等）", "priority": "P2", "source_case_ids": ["TC097"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573628+00:00"}, {"id": "kb_1705657b_4a23bb2f747c", "module": "首页访问控制", "item_type": "exception", "content": "网络异常时未登录用户点击元素走离线处理逻辑不跳转登录页，已登录用户给出加载失败提示", "priority": "P1", "source_case_ids": ["TC093", "TC094"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573644+00:00"}, {"id": "kb_1705657b_171b22e35167", "module": "首页访问控制", "item_type": "exception", "content": "已注销账号访问首页行为与未登录用户一致，点击内容跳转登录页", "priority": "P1", "source_case_ids": ["TC109"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573660+00:00"}, {"id": "kb_1705657b_78c2e0ff45e6", "module": "首页访问控制", "item_type": "exception", "content": "未登录与已登录状态下首页加载时间均在可接受范围内", "priority": "P2", "source_case_ids": ["TC106"], "status": "active", "old_content": "", "change_reason": "", "created_at": "2026-06-15T21:35:13.573676+00:00"}], "changes": []}
