se ID': 'TC007', 'Module': '登录', 'Priority': 'P0', 'Name': '手机号验证码登录-验证码发送失败-网络异常提示', 'Precondition': '用户未登录，手机号13800000001，手机网络断开', 'Steps': '1. 打开登录页面\\n2. 输入手机号13800000001\\n3. 点击获取验证码按钮', 'Assert': '1. 页面提示网络异常请重试\\n2. 手机未收到验证码短信'}, {'Case ID': 'TC008', 'Module': '登录', 'Priority': 'P0', 'Name': '手机号验证码登录-黑名单用户-登录失败', 'Precondition': '用户未登录，手机号13800000002已加入黑名单', 'Steps': '1. 打开登录页面\\n2. 输入手机号13800000002\\n3. 点击获取验证码按钮\\n4. 输入收到的验证码\\n5. 点击登录按钮', 'Assert': '1. 登录失败\\n2. 页面提示账号不可登录'}, {'Case ID': 'TC009', 'Module': '登录', 'Priority': 'P0', 'Name': '手机号验证码登录-冻结用户-登录失败', 'Precondition': '用户未登录，手机号13800000003已被冻结', 'Steps': '1. 打开登录页面\\n2. 输入手机号13800000003\\n3. 点击获取验证码按钮\\n4. 输入收到的验证码\\n5. 点击登录按钮', 'Assert': '1. 登录失败\\n2. 页面提示账号不可登录'}, {'Case ID': 'TC010', 'Module': '登录', 'Priority': 'P1', 'Name': '手机号验证码登录-同一已注册用户App登录退出后小程序端登录-成功', 'Precondition': '手机号13800000001已在App端注册，已退出登录', 'Steps': '1. 在App端使用手机号13800000001登录成功后退出\\n2. 打开小程序端\\n3. 输入手机号13800000001\\n4. 获取验证码并输入正确验证码\\n5. 点击登录', 'Assert': '1. 小程序端登录成功\\n2. 跳转至首页'}, {'Case ID': 'TC011', 'Module': '登录', 'Priority': 'P1', 'Name': '手机号验证码登录-同一已注册用户App登录退出后H5端登录-成功', 'Precondition': '手机号13800000001已在App端注册，已退出登录', 'Steps': '1. 在App端使用手机号13800000001登录成功后退出\\n2. 打开H5端\\n3. 输入手机号13800000001\\n4. 获取验证码并输入正确验证码\\n5. 点击登录', 'Assert': '1. H5端登录成功\\n2. 跳转至首页'}, {'Case ID': 'TC012', 'Module': '登录', 'Priority': 'P1', 'Name': '手机号验证码登录-输入错误验证码-提示验证码错误', 'Precondition': '用户未登录，手机号13800000001，已发送验证码但验证码为888888', 'Steps': '1. 打开登录页面\\n2. 输入手机号13800000001\\n3. 点击获取验证码\\n4. 在验证码输入框输入999999（非正确6位数字）\\n5. 点击登录按钮', 'Assert': '1. 登录失败\\n2. 页面提示验证码错误'}, {'Case ID': 'TC013', 'Module': '登录', 'Priority': 'P1', 'Name': '手机号验证码登录-验证码过期5分钟整-提示验证码过期', 'Precondition': '用户未登录，手机号13800000001，已获取验证码123456，服务端验证码过期时间已临时调整为300秒', 'Steps': '1. 打开登录页面\\n2. 输入手机号13800000001\\n3. 点击获取验证码，获得验证码123456\\n4. 等待300秒（使用系统计时器）\\n5. 输入验证码123456\\n6. 点击登录', 'Assert': '1. 登录失败\\n2. 页面提示验证码错误/已过期'}, {'Case ID': 'TC014', 'Module': '登录', 'Priority': 'P1', 'Name': '手