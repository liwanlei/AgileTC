 [{"data": {"id": "fuffnfl72tse", "created": 1780004943877, "text": "前置条件: 用户未登录，已注册手机号13800138008，密码为123456"}, "children": []}, {"data": {"id": "8y7wdjw6gfgz", "created": 1780004943877, "text": "测试步骤"}, "children": [{"data": {"id": "mj81k7obcg47", "created": 1780004943877, "text": "1. 打开登录页面"}, "children": []}, {"data": {"id": "7lix0lyh202k", "created": 1780004943877, "text": "2. 输入手机号13800138008"}, "children": []}, {"data": {"id": "k34tgooj7yjh", "created": 1780004943877, "text": "3. 输入密码123456"}, "children": []}, {"data": {"id": "w2iqu8ziol3l", "created": 1780004943877, "text": "4. 点击登录按钮"}, "children": []}]}, {"data": {"id": "ux5m9ma1byp0", "created": 1780004943877, "text": "预期结果"}, "children": [{"data": {"id": "uuym905e7nhs", "created": 1780004943877, "text": "1. 登录失败或成功但有警告"}, "children": []}, {"data": {"id": "ytiafmu7spgh", "created": 1780004943877, "text": "2. 页面提示密码强度过低建议修改"}, "children": []}]}]}, {"data": {"id": "myu7er3eew5u", "created": 1780004943877, "text": "[P2] TC025: 手机号登录-并发登录-多设备同时登录"}, "children": [{"data": {"id": "nahft26g7yi6", "created": 1780004943877, "text": "前置条件: 用户未登录，已注册手机号13800138009，两个设备"}, "children": []}, {"data": {"id": "5f4v1avgos8o", "created": 1780004943877, "text": "测试步骤"}, "children": [{"data": {"id": "t46e9qalwzji", "created": 1780004943877, "text": "1. 设备A打开登录页面输入手机号13800138009和正确密码"}, "children": []}, {"data": {"id": "nw9owad9peip", "created": 1780004943877, "text": "2. 设备B同时打开登录页面输入手机号13800138009和正确密码"}, "children": []}, {"data": {"id": "lpt14wk8if6e", "created": 1780004943877, "text": "3. 两设备同时点击登录按钮"}, "children": []}]}, {"data": {"id": "dizhsie3poq0", "created": 1780004943877, "text": "预期结果"}, "children": [{"data": {"id": "jt09cyxgmvi8", "created": 1780004943877, "text": "1. 至少一台设备登录成功"}, "children": []}, {"data": {"id": "n0o39gcxs032", "created": 1780004943877, "text": "2. 另一台设备登录成功或提示已在其他设备登录"}, "children": []}, {"data": {"id": "eln1eibzspx5", "created": 1780004943877, "text": "3. 系统正确处理并发请求"}, "children": []}]}]}, {"d