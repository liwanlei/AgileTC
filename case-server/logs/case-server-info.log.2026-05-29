 []}]}]}]}]}]}]}, {"data": {"id": "kh22vp7tb45f", "created": 1780005620492, "text": "[P2] TC025: 手机号登录-并发登录-多设备同时登录"}, "children": [{"data": {"id": "tnab1v1rwpd3", "created": 1780005620492, "text": "用户未登录，已注册手机号13800138009，两个设备", "resource": ["前置条件"]}, "children": [{"data": {"id": "g1gcrq09dkj9", "created": 1780005620492, "text": "1. 设备A打开登录页面输入手机号13800138009和正确密码", "resource": ["执行步骤"]}, "children": [{"data": {"id": "zbikow98qjtm", "created": 1780005620492, "text": "2. 设备B同时打开登录页面输入手机号13800138009和正确密码", "resource": ["执行步骤"]}, "children": [{"data": {"id": "ddig3poxbcvl", "created": 1780005620492, "text": "3. 两设备同时点击登录按钮", "resource": ["执行步骤"]}, "children": [{"data": {"id": "aykvgb4ty15m", "created": 1780005620492, "text": "1. 至少一台设备登录成功", "resource": ["预期结果"]}, "children": []}, {"data": {"id": "tfam7wj2tvxa", "created": 1780005620492, "text": "2. 另一台设备登录成功或提示已在其他设备登录", "resource": ["预期结果"]}, "children": []}, {"data": {"id": "8ing96qw25qz", "created": 1780005620492, "text": "3. 系统正确处理并发请求", "resource": ["预期结果"]}, "children": []}]}]}]}]}]}, {"data": {"id": "yf88le8uclcc", "created": 1780005620492, "text": "[P1] TC026: 手机号登录-手机号含特殊符号-格式错误"}, "children": [{"data": {"id": "uerudkantamt", "created": 1780005620492, "text": "用户未登录", "resource": ["前置条件"]}, "children": [{"data": {"id": "xgltp9l4g4gs", "created": 1780005620492, "text": "1. 打开登录页面", "resource": ["执行步骤"]}, "children": [{"data": {"id": "zac8iohy59b6", "created": 1780005620492, "text": "2. 输入手机号138-0013-8000（含横杠）", "resource": ["执行步骤"]}, "children": [{"data": {"id": "jk228yz69qdz", "created": 1780005620492, "text": "3. 输入任意密码", "resource": ["执行步骤"]}, "children": [{"data": {"id": "9sc2go60spde", "created": 1780005620492, "text": "4. 点击登录按钮", "resource": ["执行步骤"]}, "children": [{"data": {"id": "fvf9eg0rf70w", "created": 1780005620492, "text": "1. 登录失败", "resource": ["预期结果"]}, "children": []}, {"data": {"id": "eow02o8hcd8m", "created": 1780005620492, "text": "2. 页面提示手机号格式错误", "resource": ["预期结果"]}, "children": []}]}]}]}]}]}]}, {"data": {"id": "5v0rlakjmat9", "created": 1780005620492, "text": "[P2] TC027: 手机号登录-登录频率限制-防暴力破解"}, "children": [{"data": {"id": "0bmjkdze0m6u", "created": 1780005620492, "text": "用户未登录，已注册手机号13800138010", "resource": ["前置条件"]}, "children": [{"data": {"id": "kc1nj1cu2uox", "created": 1780005620492, "text": "1. 打开登录页面", "resource": ["执行步骤"]}, "children": [{"data": {"id": "va8yptsmz976", "created": 1780005620492, "text": "2. 1分钟内连续10次输入手机号13800138010和任意密码点击登录", "resource": ["执行步骤"]}, "children": [{"data": {"id": "73axzq4cdlzs", "created": 1780005620492, "text": "1. 前几次登录失败", "resource": ["预期结果"]}, "children": []}, {"data": {"id": "3hyy27dza8k1", "created": 1780005620492, "text": "2. 后续请求被限制", "resource": ["预期结果"]}, "children": []}, {"data": {"id": "xi55o0l06a43", "created": 1780005620492, "text": "3. 页面提示操作过于频繁请稍后再试", "resource": ["预期结果"]}, "children": []}]}]}]}]}]}, "template": "default", "theme": "fresh-blue", "version": "1.4.43", "base": 10, "right": 1}

