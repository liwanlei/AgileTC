2026-06-13 20:51:13.236 [nioEventLoopGroup-3-1][INFO ][com.xiaoju.framework.handler.RoomEntity.<init>(RoomEntity.java:43)]:case content is: {"root":{"data":{"id":"9t7xirauwe4d","created":1780801903522,"text":"登录：手机号 + 短信验证码。\r\n        - 验证码：6位数字；有效期5分钟；同手机号发送间隔≥60s；日上限10次（示例）。\r\n        - 手机号：大陆11位），支持带/不带空格与`+86`。\r\n        - 账号态：新用户自动注册/引导注册；黑名单/冻结不可登录，服务端控制黑名单列表。\r\n        - 多端：App/小程序/H5支持。新用户自动注册并登录。只支持手机号验证码登录，\r\n        - 手机号规则只包含国内，验证码错误会提示验证码错误，有效期五分钟从生成时间算\r\n        - 60s间隔和每日10次限额是固定的\r\n        注册：手机号 + 短信验证码 如果是新用户就注册，注册需要填写账号名称，上传头像，两个不能为空。为空注册不成。\r\n        注销：用户提交注销，提示注销成功，7个工作日注销7个工作日内登录，注销停止。7个工作日内未登录后，注销完成\r\n        首页：首页不需要登录，点击首页任内容都需要判断登录。\r\n       "},"children":[{"data":{"id":"emrxegzbmv0l","created":1780801903522,"text":"[P0] TC001: 手机号验证码登录-已注册用户正确手机号登录-成功跳转首页"},"children":[{"data":{"id":"m9jxaaqp8auk","created":1780801903522,"text":"用户未登录，已注册手机号13800000001，服务端验证码接口正常","resource":["前置条件"]},"children":[{"data":{"id":"r1xh21o1k5ln","created":1780801903522,"text":"1. 打开登录页面","resource":["执行步骤"]},"children":[{"data":{"id":"hkavbk0ytq5t","created":1780801903522,"text":"2. 在手机号输入框输入13800000001","resource":["执行步骤"]},"children":[{"data":{"id":"s2iz5jc0ktin","created":1780801903522,"text":"3. 点击获取验证码按钮","resource":["执行步骤"]},"children":[{"data":{"id":"cxquqzhpy4au","created":1780801903522,"text":"4. 查看短信，获取6位验证码123456","resource":["执行步骤"]},"children":[{"data":{"id":"iupyu9rsqi9u","created":1780801903522,"text":"5. 在验证码输入框输入123456","resource":["执行步骤"]},"children":[{"data":{"id":"kqxnrcht7gyf","created":1780801903522,"text":"6. 点击登录按钮","resource":["执行步骤"]},"children":[{"data":{"id":"7guqms52qqns","created":1780801903522,"text":"1. 页面跳转至首页","resource":["预期结果"]},"children":[]},{"data":{"id":"zg9qwfzyi1vb","created":1780801903522,"text":"2. 首页显示用户已登录状态","resource":["预期结果"]},"children":[]},{"data":{"id":"3qkal2wodv5j","created":1780801903522,"text":"3. 响应体中返回有效token","resource":["预期结果"]},"children":[]}]}]}]}]}]}]}]}]},{"data":{"id":"z0k0z4beehc4","c